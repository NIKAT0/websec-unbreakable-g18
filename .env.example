# Kopieer naar .env (staat in .gitignore) en vul eigen, lange willekeurige waarden in.
# Enkel letters en cijfers: het OpenFGA-wachtwoord staat in een URL.
#   bv. head -c 36 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-32
# Let op: een databank neemt het wachtwoord enkel over bij de allereerste start.
# Later wijzigen = ook ALTER USER in de databank zelf.
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
OPENFGA_DB_PASSWORD=
OPENFGA_KEY=
